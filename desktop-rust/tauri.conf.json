{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeChatAgentDesktop",
  "version": "0.1.0",
  "identifier": "com.lyph.wechat-agent-desktop",
  "build": {
    "frontendDist": "../desktop/web",
    "devUrl": "http://127.0.0.1:0",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "微信 Agent 控制台",
        "width": 1320,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ],
    "category": "DeveloperTool"
  }
}
